# .env.example
# Copie este arquivo para .env e ajuste os valores conforme necessario.
# NUNCA comite o .env real no repositorio.

DATABASE_NAME=lifeforge
DATABASE_USER=lifeforge
DATABASE_PASSWORD=lifeforge

# Em producao, gere com: openssl rand -base64 64
JWT_SECRET=change-me-in-production-use-a-long-random-string

# CORS: origens permitidas (lista separada por virgula). Se vazio/ausente,
# libera qualquer origem (apenas para desenvolvimento local). Em producao,
# defina os dominios reais, ex.: app.lifeforge.com,admin.lifeforge.com
CORS_ALLOWED_HOSTS=
